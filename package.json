{
	"type": "module",
	"dependencies": {},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bun": "1.4.2",
		"happy-dom": "^20.14.5",
		"typescript": "7.0.2",
		"vite": "8.3.0"
	},
	"scripts": {
		"dev": "vite",
		"build:wasm": "bun scripts/build-wasm.ts",
		"check:wasm": "bun scripts/build-wasm.ts --check",
		"test:browser": "bun scripts/test-browser.ts",
		"build": "bun run build:wasm && vite build",
		"preview": "vite preview",
		"bench": "bun benchmarks/physics.bench.ts",
		"validate:baseline": "bun scripts/validate-baseline.ts",
		"validate:fire-legacy": "bun scripts/fire-corrected-baseline.ts",
		"validate:docs": "python3 docs/scripts/validate-docs.py",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"typecheck:catalogue": "tsc --noEmit -p tsconfig.catalogue.json",
		"test": "bun test ./tests",
		"check": "bun run typecheck && bun run typecheck:catalogue && bun run test"
	}
}
