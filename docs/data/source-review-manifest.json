        },
        {
          "path": "src/app/controls.ts",
          "startLine": 22,
          "endLine": 36
        }
      ],
      "implication": "Use the narrow facade as the migration seam, but replace fresh synchronous probes with asynchronous tick/epoch-stamped samples."
    },
    {
      "id": "SRC-04",
      "title": "Current pressure refresh call graph",
      "locations": [
        {
          "path": "src/simulation/physics.ts",
          "startLine": 56,
          "endLine": 98
        },
        {
          "path": "src/physics/gas-dynamics.ts",
          "startLine": 184,
          "endLine": 185
        }
      ],
      "implication": "Four unconditional derivations per normal physics tick: three direct calls and one inside gas.step; a fifth is conditional on ventOpenEdges(). Commands can add more."
    },
    {
      "id": "SRC-05",
      "title": "Per-grain overlapping outlet searches",
      "locations": [
        {
          "path": "src/physics/motion.ts",
          "startLine": 65,
          "endLine": 127
        }
      ],
      "implication": "One settling attempt can traverse a connected liquid region twice. Replace the algorithm through batched topology and conservative accommodation; a language port preserves the search pattern."
    },
    {
      "id": "SRC-06",
      "title": "Multiple motion mechanisms share world state",
      "locations": [
        {
          "path": "src/simulation/physics.ts",
          "startLine": 63,
          "endLine": 98
        },
        {
          "path": "src/physics/fluid-solver.ts",
          "startLine": 1,
          "endLine": 114
        }
      ],
      "implication": "Give each new-model scene exactly one conservative transport owner; keep legacy scenes separate."
    },
    {
      "id": "SRC-07",
      "title": "Byte material IDs and Float64 parcel arrays",
      "locations": [
        {
          "path": "src/simulation/world.ts",
          "startLine": 36,
          "endLine": 88
        },
        {
          "path": "src/simulation/world.ts",
          "startLine": 123,
          "endLine": 147
        }
      ],
      "implication": "Preserve legacy IDs in conversion but introduce distinct wider stable material/species/nuclide IDs and compact scene-local mappings."
    },
    {
      "id": "SRC-08",
      "title": "Legacy energy has mixed representations",
      "locations": [
        {
          "path": "src/simulation/world.ts",
          "startLine": 182,
          "endLine": 223
        },
        {
          "path": "src/simulation/diagnostics.ts",
