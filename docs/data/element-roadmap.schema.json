{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:particle-foundry:element-roadmap:v1",
  "title": "Particle Foundry element delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "updatedAt",
    "kind",
    "description",
    "tierCounts",
    "cumulativeTargets",
    "elements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "kind": {
      "const": "planning-manifest-not-runtime-properties"
    },
    "description": {
      "type": "string"
    },
    "tierCounts": {
      "const": {
        "core": 40,
        "extended": 43,
        "nuclear": 20,
        "exotic": 15
      }
    },
    "cumulativeTargets": {
      "const": [
        40,
        83,
        103,
        118
      ]
    },
    "elements": {
      "type": "array",
      "minItems": 118,
      "maxItems": 118,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atomicNumber",
          "symbol",
          "name",
          "tier",
          "targetPhase",
          "targetRepresentation",
          "legacyModelDocumented",
          "newBackendStatus",
          "sourceIds"
        ],
        "properties": {
          "atomicNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 118
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][a-z]?$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "core",
              "extended",
              "nuclear",
              "exotic"
            ]
          },
          "targetPhase": {
            "enum": [
              "P4",
              "P5",
              "P6",
              "P8"
            ]
          },
          "targetRepresentation": {
            "enum": [
              "elemental-material",
              "nuclide-first",
              "nuclide-and-labelled-creative-material"
            ]
          },
          "legacyModelDocumented": {
            "type": "boolean"
          },
          "newBackendStatus": {
            "enum": [
              "planned",
              "experimental",
              "validated"
            ]
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
